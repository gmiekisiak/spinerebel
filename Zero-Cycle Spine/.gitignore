# Never commit recordings or derived data to git — they live elsewhere.
*.BIN
*.bin
*.TAU
*.zip
*_TARS31.csv
*_TARS60.csv

# Manifests ARE committed — they are the integrity record.
!SHA256SUMS.txt
!CONTENTS.sha256

# Figures are regenerated, not tracked, unless a published version is pinned.
*.png
*.pdf
*.svg
!docs/figures/published/*

__pycache__/
*.py[cod]
.venv/
venv/
.env
.ipynb_checkpoints/
.DS_Store
Thumbs.db
